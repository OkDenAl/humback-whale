{
    "swagger": "2.0",
    "info": {
        "description": "Text markup - it is the service for getting markup from text.",
        "title": "Humpback whale recognition service",
        "contact": {
            "name": "humback-whale",
            "url": "https://github.com/OkDenAl/humback-whale"
        },
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/upload/{author_id}": {
            "post": {
                "description": "get markup from text",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Markup"
                ],
                "summary": "get markup from text",
                "parameters": [
                    {
                        "description": "Image (bytes)",
                        "name": "text",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.uploadImgReq"
                        }
                    },
                    {
                        "type": "file",
                        "description": "File to upload",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "File to upload",
                        "name": "latitude",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "File to upload",
                        "name": "longitude",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Author ID (uuid)",
                        "name": "author_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.httpError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.httpError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.httpError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "handler.uploadImgReq": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                },
                "whale_type": {
                    "type": "string"
                }
            }
        }
    }
}